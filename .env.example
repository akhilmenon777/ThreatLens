# Copy to .env and adjust. No secrets are required by this application.
# SQLite file location (default: runtime/ntdcp.db). Any SQLAlchemy URL works.
# NTDCP_DATABASE_URL=sqlite:///./runtime/ntdcp.db
# NTDCP_RUNTIME_DIR=./runtime
# Directory holding demo/ and mappings/ (default: ./data)
# NTDCP_DATA_DIR=./data
NTDCP_MAX_UPLOAD_MB=50
NTDCP_MAX_FIELD_CHARS=2048
NTDCP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local Ollama only. The default can be changed later on the Settings page.
NTDCP_OLLAMA_BASE_URL=http://127.0.0.1:11434
